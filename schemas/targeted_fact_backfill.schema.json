{
  "$defs": {
    "BackfillFieldResolution": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "resolved_explicit",
            "resolved_derived",
            "resolved_visual_estimate",
            "not_found_in_paper",
            "ambiguous_or_conflicting"
          ],
          "title": "Status",
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "$ref": "#/$defs/RequiredFactRef"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "searched_locations": {
          "items": {
            "type": "string"
          },
          "title": "Searched Locations",
          "type": "array"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "status",
        "note"
      ],
      "title": "BackfillFieldResolution",
      "type": "object"
    },
    "BackfillRequestResolution": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "field_results": {
          "items": {
            "$ref": "#/$defs/BackfillFieldResolution"
          },
          "minItems": 1,
          "title": "Field Results",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "field_results"
      ],
      "title": "BackfillRequestResolution",
      "type": "object"
    },
    "EngineeringFact": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "channel_model",
            "modulation",
            "coding",
            "metric",
            "simulation_parameter",
            "baseline",
            "figure_claim",
            "algorithm",
            "dataset",
            "topology",
            "hardware",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "additionalProperties": true,
          "title": "Value",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/FactSource"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "used_for_reproduction": {
          "title": "Used For Reproduction",
          "type": "boolean"
        },
        "evidence_kind": {
          "default": "paper_explicit",
          "enum": [
            "paper_explicit",
            "paper_derived",
            "visual_estimate"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "derivation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derivation"
        }
      },
      "required": [
        "type",
        "name",
        "value",
        "source",
        "confidence",
        "used_for_reproduction"
      ],
      "title": "EngineeringFact",
      "type": "object"
    },
    "FactSource": {
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "enum": [
            "text",
            "figure"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Chunk Id"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "figure_ref": {
          "title": "Figure Ref",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "chunk_id",
        "page",
        "section",
        "quote",
        "figure_ref"
      ],
      "title": "FactSource",
      "type": "object"
    },
    "MissingInformation": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "why_needed": {
          "minLength": 1,
          "title": "Why Needed",
          "type": "string"
        },
        "impact": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Impact",
          "type": "string"
        }
      },
      "required": [
        "name",
        "why_needed",
        "impact"
      ],
      "title": "MissingInformation",
      "type": "object"
    },
    "RequiredFactRef": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "channel_model",
            "modulation",
            "coding",
            "metric",
            "simulation_parameter",
            "baseline",
            "figure_claim",
            "algorithm",
            "dataset",
            "topology",
            "hardware",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "RequiredFactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "paper_domain": {
      "const": "communication",
      "title": "Paper Domain",
      "type": "string"
    },
    "paper_repro_type": {
      "enum": [
        "signal_chain",
        "modulation_recognition",
        "channel_coding",
        "mimo_ofdm",
        "network_protocol",
        "ml_communication",
        "optimization_algorithm",
        "hardware_dataset",
        "other"
      ],
      "title": "Paper Repro Type",
      "type": "string"
    },
    "engineering_facts": {
      "items": {
        "$ref": "#/$defs/EngineeringFact"
      },
      "title": "Engineering Facts",
      "type": "array"
    },
    "missing_information": {
      "items": {
        "$ref": "#/$defs/MissingInformation"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "request_resolutions": {
      "items": {
        "$ref": "#/$defs/BackfillRequestResolution"
      },
      "title": "Request Resolutions",
      "type": "array"
    }
  },
  "required": [
    "paper_domain",
    "paper_repro_type",
    "engineering_facts",
    "missing_information",
    "request_resolutions"
  ],
  "title": "TargetedFactBackfillDocument",
  "type": "object"
}
