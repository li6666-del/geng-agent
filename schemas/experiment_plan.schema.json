        }
      },
      "title": "ScientificAcceptance",
      "type": "object"
    },
    "ScientificArchitectureDocument": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "1.1"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "components": {
                "items": {
                  "properties": {
                    "callable": {
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    },
                    "execution": {
                      "not": {
                        "type": "null"
                      }
                    }
                  },
                  "required": [
                    "callable",
                    "execution"
                  ]
                }
              }
            }
          }
        }
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "workflow_version": {
          "const": "2",
          "default": "2",
          "title": "Workflow Version",
          "type": "string"
        },
        "quantities": {
          "items": {
            "$ref": "#/$defs/ArchitectureQuantity"
          },
          "title": "Quantities",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ArchitectureComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "consistency_groups": {
          "items": {
            "$ref": "#/$defs/ArchitectureConsistencyGroup"
          },
          "title": "Consistency Groups",
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/ArchitectureBinding"
          },
          "minItems": 1,
          "title": "Bindings",
          "type": "array"
        },
        "invariants": {
          "items": {
