{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "default_value": {
          "title": "Default Value"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "field_ids": {
          "items": {
            "type": "string"
          },
          "title": "Field Ids",
          "type": "array"
        },
        "sensitivity_check": {
          "default": "",
          "title": "Sensitivity Check",
          "type": "string"
        }
      },
      "required": [
        "name",
        "default_value",
        "reason",
        "risk"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "baselines": {
          "items": {
            "type": "string"
          },
          "title": "Baselines",
          "type": "array"
        },
        "curve_groups": {
          "items": {
            "type": "string"
          },
          "title": "Curve Groups",
          "type": "array"
        },
        "tolerance": {
          "minLength": 1,
          "title": "Tolerance",
          "type": "string"
        }
      },
      "required": [
        "baselines",
        "curve_groups",
        "tolerance"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "ExpectedTrend": {
      "additionalProperties": false,
      "properties": {
        "x_axis": {
          "title": "X Axis",
          "type": "string"
        },
        "y_axis": {
          "title": "Y Axis",
          "type": "string"
        },
        "direction": {
          "enum": [
            "decreasing",
            "increasing",
            "flat",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "x_axis",
        "y_axis",
        "direction",
        "reason"
      ],
      "title": "ExpectedTrend",
      "type": "object"
    },
    "MissingFactRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "channel_model",
            "modulation",
            "coding",
            "metric",
            "simulation_parameter",
            "baseline",
            "figure_claim",
            "algorithm",
            "dataset",
            "topology",
            "hardware",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "why_needed": {
          "minLength": 1,
          "title": "Why Needed",
          "type": "string"
        },
        "impact": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Impact",
          "type": "string"
        },
        "search_targets": {
          "items": {
            "type": "string"
          },
          "title": "Search Targets",
          "type": "array"
        },
        "required_fields": {
          "items": {
            "$ref": "#/$defs/RequestedFactField"
          },
          "title": "Required Fields",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "type",
        "name",
        "why_needed",
        "impact",
        "search_targets"
      ],
      "title": "MissingFactRequest",
      "type": "object"
    },
    "ReproTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "metric": {
          "enum": [
            "bit_error_rate",
            "symbol_error_rate",
            "throughput",
            "delay",
            "spectral_efficiency",
            "outage_probability",
            "energy_efficiency",
            "accuracy",
            "loss",
            "other"
          ],
          "title": "Metric",
          "type": "string"
        },
        "metric_formula": {
          "minLength": 1,
          "title": "Metric Formula",
          "type": "string"
        },
        "figure_or_claim": {
          "minLength": 1,
          "title": "Figure Or Claim",
          "type": "string"
        },
        "expected_artifacts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Artifacts",
          "type": "array"
        },
        "output_columns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Output Columns",
          "type": "array"
        },
        "expected_trend": {
          "$ref": "#/$defs/ExpectedTrend"
        },
        "comparison": {
          "$ref": "#/$defs/Comparison"
        },
        "required_facts": {
          "items": {
            "$ref": "#/$defs/RequiredFactRef"
          },
          "title": "Required Facts",
          "type": "array"
        },
        "missing_fact_requests": {
          "items": {
            "$ref": "#/$defs/MissingFactRequest"
          },
          "title": "Missing Fact Requests",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "risk_if_unreproducible": {
          "minLength": 1,
          "title": "Risk If Unreproducible",
          "type": "string"
        },
        "formula_chain": {
          "items": {
            "$ref": "#/$defs/TaskSpecificationItem"
          },
          "title": "Formula Chain",
          "type": "array"
        },
        "scientific_acceptance": {
          "$ref": "#/$defs/ScientificAcceptance"
        },
        "parameter_matrix": {
          "items": {
            "$ref": "#/$defs/TaskSpecificationItem"
          },
          "title": "Parameter Matrix",
          "type": "array"
        },
        "baseline_definitions": {
          "items": {
            "$ref": "#/$defs/TaskSpecificationItem"
          },
          "title": "Baseline Definitions",
          "type": "array"
        },
        "statistical_protocol": {
          "items": {
            "$ref": "#/$defs/TaskSpecificationItem"
          },
          "title": "Statistical Protocol",
          "type": "array"
        },
        "validation_anchors": {
          "items": {
            "$ref": "#/$defs/TaskSpecificationItem"
          },
          "title": "Validation Anchors",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "target",
        "metric",
        "metric_formula",
        "figure_or_claim",
        "expected_artifacts",
        "output_columns",
        "expected_trend",
        "comparison",
        "required_facts",
        "assumptions",
        "risk_if_unreproducible"
      ],
      "title": "ReproTask",
      "type": "object"
    },
    "RequestedFactField": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "affects": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affects",
          "type": "array"
        }
      },
      "required": [
        "field_id",
        "description"
      ],
      "title": "RequestedFactField",
      "type": "object"
    },
    "RequiredFactRef": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "channel_model",
            "modulation",
            "coding",
            "metric",
            "simulation_parameter",
            "baseline",
            "figure_claim",
            "algorithm",
            "dataset",
            "topology",
            "hardware",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "RequiredFactRef",
      "type": "object"
    },
    "ScientificAcceptance": {
      "additionalProperties": false,
      "description": "Small shared vocabulary, not a completeness gate.",
      "properties": {
        "contract_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "core_conclusions": {
          "items": {
            "$ref": "#/$defs/ScientificCoreConclusion"
          },
          "title": "Core Conclusions",
          "type": "array"
        },
        "key_numeric_targets": {
          "items": {
            "$ref": "#/$defs/ScientificNumericTarget"
          },
          "title": "Key Numeric Targets",
          "type": "array"
        },
        "information_gaps": {
          "items": {
            "$ref": "#/$defs/ScientificInformationGap"
          },
          "title": "Information Gaps",
          "type": "array"
        }
      },
      "title": "ScientificAcceptance",
      "type": "object"
    },
    "ScientificCoreConclusion": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "default": "",
          "title": "Claim Id",
          "type": "string"
        },
        "statement": {
          "default": "",
          "title": "Statement",
          "type": "string"
        },
        "kind": {
          "default": "other",
          "enum": [
            "ordering",
            "trend",
            "crossing",
            "threshold",
            "scaling",
            "gain_loss",
            "mechanism",
            "absolute_level",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "regime": {
          "default": "",
          "title": "Regime",
          "type": "string"
        },
        "paper_anchor": {
          "default": "",
          "title": "Paper Anchor",
          "type": "string"
        }
      },
      "title": "ScientificCoreConclusion",
      "type": "object"
    },
    "ScientificInformationGap": {
      "additionalProperties": false,
      "properties": {
        "gap_id": {
          "default": "",
          "title": "Gap Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "affects_claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affects Claim Ids",
          "type": "array"
        },
        "disposition": {
          "default": "assume_and_disclose",
          "enum": [
            "assume_and_disclose",
            "single_sensitivity_if_core",
            "terminal_inconclusive"
          ],
          "title": "Disposition",
          "type": "string"
        }
      },
      "title": "ScientificInformationGap",
      "type": "object"
    },
    "ScientificNumericTarget": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "default": "",
          "title": "Target Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "paper_magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Magnitude"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "regime": {
          "default": "",
          "title": "Regime",
          "type": "string"
        },
        "evidence_quality": {
          "default": "unavailable",
          "enum": [
            "paper_explicit",
            "paper_derived",
            "visual_estimate",
            "unavailable"
          ],
          "title": "Evidence Quality",
          "type": "string"
        }
      },
      "title": "ScientificNumericTarget",
      "type": "object"
    },
    "TaskSpecificationItem": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "status": {
          "enum": [
            "evidenced",
            "assumed",
            "not_applicable",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_facts": {
          "items": {
            "$ref": "#/$defs/RequiredFactRef"
          },
          "title": "Evidence Facts",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "TaskSpecificationItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "repro_tasks": {
      "items": {
        "$ref": "#/$defs/ReproTask"
      },
      "minItems": 1,
      "title": "Repro Tasks",
      "type": "array"
    }
  },
  "required": [
    "repro_tasks"
  ],
  "title": "ReproTasksDocument",
  "type": "object"
}
