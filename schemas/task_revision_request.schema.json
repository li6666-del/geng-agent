{
  "$defs": {
    "ErrorCategory": {
      "enum": [
        "analysis_scope",
        "contract_error",
        "code_or_runtime",
        "environment"
      ],
      "title": "ErrorCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Code-local contract for a request sent back to a task worker.",
  "properties": {
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "scenario": {
      "minLength": 1,
      "title": "Scenario",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ],
      "title": "Error"
    },
    "requested_changes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Requested Changes",
      "type": "array"
    },
    "reentry_count": {
      "default": 0,
      "minimum": 0,
      "title": "Reentry Count",
      "type": "integer"
    },
    "category": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCategory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "task_id",
    "scenario",
    "error",
    "requested_changes"
  ],
  "title": "RevisionRequest",
  "type": "object"
}
