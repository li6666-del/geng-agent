{
  "$defs": {
    "CoreConclusionAssessment": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "default": "",
          "title": "Claim Id",
          "type": "string"
        },
        "status": {
          "default": "unassessable_missing_information",
          "enum": [
            "supported",
            "unsupported",
            "unassessable_missing_information",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "local_observation": {
          "default": "",
          "title": "Local Observation",
          "type": "string"
        },
        "evidence_files": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Files",
          "type": "array"
        },
        "basis_review": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis Review"
        }
      },
      "title": "CoreConclusionAssessment",
      "type": "object"
    },
    "KeyNumericComparison": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "default": "",
          "title": "Target Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "paper_magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Paper Magnitude"
        },
        "local_magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Magnitude"
        },
        "symmetric_ratio": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symmetric Ratio"
        },
        "unavailable_reason": {
          "default": "",
          "title": "Unavailable Reason",
          "type": "string"
        },
        "comparison_status": {
          "default": "comparable",
          "title": "Comparison Status",
          "type": "string"
        },
        "metric": {
          "default": "",
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "regime": {
          "default": "",
          "title": "Regime",
          "type": "string"
        },
        "local_metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Metric"
        },
        "local_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Unit"
        },
        "local_regime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Regime"
        },
        "incompatible_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Incompatible Dimensions",
          "type": "array"
        },
        "basis_review": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis Review"
        }
      },
      "required": [
        "paper_magnitude",
        "local_magnitude"
      ],
      "title": "KeyNumericComparison",
      "type": "object"
    },
    "TaskVerificationResult": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "default": "",
          "title": "Task Id",
          "type": "string"
        },
        "outcome": {
          "default": "inconclusive_missing_information",
          "enum": [
            "reproduced",
            "reproduced_with_assumptions",
            "inconclusive_missing_information",
            "not_reproduced",
            "execution_failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "host_action": {
          "default": "complete",
          "enum": [
            "complete",
            "rerun_writer"
          ],
          "title": "Host Action",
          "type": "string"
        },
        "rerun_reason": {
          "default": "none",
          "enum": [
            "none",
            "core_conclusion_failed",
            "key_numeric_ratio_ge_10",
            "invalid_run"
          ],
          "title": "Rerun Reason",
          "type": "string"
        },
        "run_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Valid"
        },
        "core_conclusions": {
          "items": {
            "$ref": "#/$defs/CoreConclusionAssessment"
          },
          "title": "Core Conclusions",
          "type": "array"
        },
        "key_numeric_comparisons": {
          "items": {
            "$ref": "#/$defs/KeyNumericComparison"
          },
          "title": "Key Numeric Comparisons",
          "type": "array"
        },
        "max_key_numeric_ratio": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Key Numeric Ratio"
        },
        "comparison_summary": {
          "default": "",
          "title": "Comparison Summary",
          "type": "string"
        },
        "differences": {
          "items": {
            "type": "string"
          },
          "title": "Differences",
          "type": "array"
        },
        "non_material_differences": {
          "items": {
            "type": "string"
          },
          "title": "Non Material Differences",
          "type": "array"
        },
        "evidence_files": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Files",
          "type": "array"
        },
        "feedback": {
          "items": {
            "type": "string"
          },
          "title": "Feedback",
          "type": "array"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "remaining_uncertainties": {
          "items": {
            "type": "string"
          },
          "title": "Remaining Uncertainties",
          "type": "array"
        },
        "verified_facts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Verified Facts",
          "type": "array"
        },
        "provenance_base": {
          "default": "",
          "title": "Provenance Base",
          "type": "string"
        }
      },
      "title": "TaskVerificationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "all_terminal": {
      "default": false,
      "title": "All Terminal",
      "type": "boolean"
    },
    "all_successful": {
      "default": false,
      "title": "All Successful",
      "type": "boolean"
    },
    "outcome_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Outcome Counts",
      "type": "object"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/TaskVerificationResult"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "title": "VerificationResultDocument",
  "type": "object"
}
