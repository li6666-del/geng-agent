[Unit]
Description=Expire Geng Agent website delivery archives after seven days

[Service]
Type=oneshot
User=geng-web
Group=geng-web
WorkingDirectory=/opt/geng-agent-web/current
EnvironmentFile=/etc/geng-agent-web.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/geng-agent-web/venv/bin/python -m geng_agent.web.retention --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/geng-agent-web
UMask=0077
